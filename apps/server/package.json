{
  "name": "@pi-agent/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @pi-agent/contracts build && pnpm --filter @pi-agent/agent build && tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@pi-agent/agent": "workspace:*",
    "@pi-agent/contracts": "workspace:*",
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
