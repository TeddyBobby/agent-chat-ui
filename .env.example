# PiAgent environment variables
# Export these variables before `pnpm dev` / server start.

# Remote model fallbacks. A key saved from the UI takes precedence.
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama and other local OpenAI-compatible APIs do not require a key.
# Example: http://127.0.0.1:11434/v1

# Optional outbound proxy
# HTTPS_PROXY=http://127.0.0.1:8118

# API Server
# PORT=8787
# HOST=127.0.0.1
# PI_AGENT_DB=/absolute/path/to/pi-agent.db
# PI_AGENT_WORKDIR=/absolute/path/to/default/workspace
# PI_AGENT_WEB_ORIGIN=http://localhost:3001

# Stable base64-encoded 32-byte AES master key.
# Generate with: openssl rand -base64 32
# If omitted, a separate <database>.key file is created with mode 0600.
# PI_AGENT_MASTER_KEY=

# Web build-time API address for a separately deployed frontend.
# Electron supplies a validated loopback runtime address automatically.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
