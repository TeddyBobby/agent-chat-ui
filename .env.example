# Agent Chat UI — Environment Variables
# Export these variables before running `pnpm dev`, or load them with your shell.

# ---- OpenAI (default) ----
OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- DeepSeek ----
# When model ID starts with "deepseek", these are used instead of OpenAI configs
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Other providers ----
# For Ollama (local): select "gemma4:e4b" model in UI — base URL auto-set
# For any OpenAI-compatible API, use OPENAI_API_KEY + OPENAI_BASE_URL

# ---- Network proxy (if behind firewall) ----
# HTTPS_PROXY=http://127.0.0.1:8118

# ---- PiAgent server ----
# PORT=8787
# HOST=127.0.0.1
# PI_AGENT_DB=/absolute/path/to/pi-agent.db
